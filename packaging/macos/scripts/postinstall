#!/bin/sh
set -eu

# LaunchAgents are owner-scoped. If a GUI user is present, load the installed
# definition in that user's launchd domain without creating root-owned state.
docker_link="/usr/local/bin/docker"
managed_docker="/usr/local/libexec/remote-docker/bin/docker"
docker_link_owner="/usr/local/libexec/remote-docker/.docker-link-owner"
docker_link_owner_value="remote-docker-managed-link-v1"
if [ -e "${docker_link}" ] || [ -L "${docker_link}" ]; then
  if [ ! -L "${docker_link}" ] || \
    [ "$(readlink "${docker_link}")" != "${managed_docker}" ] || \
    [ ! -f "${docker_link_owner}" ] || \
    [ "$(cat "${docker_link_owner}")" != "${docker_link_owner_value}" ]; then
    printf '%s\n' "Remote Docker refused to replace the existing command at ${docker_link}." >&2
    exit 1
  fi
else
  printf '%s\n' "${docker_link_owner_value}" >"${docker_link_owner}"
  if ! ln -s "${managed_docker}" "${docker_link}"; then
    rm -f "${docker_link_owner}"
    printf '%s\n' "Remote Docker could not reserve ${docker_link}; no existing command was replaced." >&2
    exit 1
  fi
fi

console_user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
case "${console_user}" in
  ""|root|loginwindow) exit 0 ;;
esac
console_uid="$(id -u "${console_user}" 2>/dev/null || true)"
case "${console_uid}" in
  ""|*[!0-9]*) exit 0 ;;
esac

domain="gui/${console_uid}"
label="io.github.dmitbd.remote-docker.agent"
plist="/Library/LaunchAgents/${label}.plist"
launchctl_bin="/bin/launchctl"
"${launchctl_bin}" asuser "${console_uid}" "${launchctl_bin}" bootout "${domain}/${label}" >/dev/null 2>&1 || true
if ! "${launchctl_bin}" asuser "${console_uid}" "${launchctl_bin}" bootstrap "${domain}" "${plist}" >/dev/null 2>&1; then
  printf '%s\n' "Remote Docker was installed; its background agent will start at the next login." >&2
fi
exit 0
